{
  "_comentario": "Trecho a mesclar no manifest (vite-plugin-pwa). Faz o Pratoria instalado aparecer no menu Compartilhar do Android (links, textos e arquivos .pratoria.txt) e abrir arquivos no desktop Chromium.",
  "share_target": {
    "action": "./receber-compartilhado",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "url",
      "files": [
        {
          "name": "arquivo",
          "accept": [
            ".pratoria",
            ".zip",
            ".md",
            ".txt",
            "application/zip",
            "application/octet-stream",
            "text/markdown",
            "text/plain",
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./receber",
      "accept": {
        "application/x-pratoria": [
          ".pratoria"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ]
}